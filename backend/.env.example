APP_NAME=Stride API
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Leave empty for local development. When set, send it as X-API-Key.
API_KEY=
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# DATABASE_URL takes precedence over individual Postgres settings.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stride_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_CONNECT_TIMEOUT=2

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
MODEL_REQUEST_TIMEOUT=120
CONVERSATIONAL_MODEL_ENABLED=true
LANGGRAPH_POSTGRES_CHECKPOINTER=true

EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
